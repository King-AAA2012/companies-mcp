# Required: free GSTINAPI_KEY from https://gstinapi.com (free tier: 75 lookups/day, no card).
# Optional: local GSTIN validation works without a key; only gst_lookup / gst_bulk live data needs it.
GSTINAPI_KEY=

# Optional: MCP transport. Default is stdio (recommended for local use).
# MCP_TRANSPORT=http
# MCP_PORT=8765
