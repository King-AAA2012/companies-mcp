{
  "name": "india-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A monorepo of MCP servers for Indian data: GSTIN, PIN code, company lookups, PAN validation, IRCTC trains, and UPI. Each package is a standalone Model Context Protocol server for Claude and other MCP clients.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "india",
    "indian-data",
    "gst",
    "pincode",
    "pan",
    "irctc",
    "upi"
  ],
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "gst-mcp",
    "pincode-mcp",
    "companies-mcp",
    "pan-mcp",
    "irctc-mcp",
    "upi-mcp",
    "election-mcp",
    "holidays-mcp",
    "rto-mcp"
  ],
  "scripts": {
    "gst-mcp": "npm --prefix gst-mcp",
    "pincode-mcp": "npm --prefix pincode-mcp",
    "companies-mcp": "npm --prefix companies-mcp",
    "pan-mcp": "npm --prefix pan-mcp",
    "irctc-mcp": "npm --prefix irctc-mcp",
    "upi-mcp": "npm --prefix upi-mcp",
    "election-mcp": "npm --prefix election-mcp",
    "holidays-mcp": "npm --prefix holidays-mcp",
    "rto-mcp": "npm --prefix rto-mcp"
  }
}
